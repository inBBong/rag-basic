    </main>

    <div class="navbar">
      <button class="nav-btn" id="prev">← <span class="lbl">이전</span></button>
      <div class="keyhint"><kbd>←</kbd> <kbd>→</kbd> 로 넘기기</div>
      <button class="nav-btn" id="next"><span class="lbl">다음</span> →</button>
    </div>
  </div>
</div>

<script>
  const STAGES = {
    0: "프로젝트 지도",
    1: "data",
    2: "pipeline",
    3: "app (뿌리 3개)",
    4: "app/models",
    5: "app/schemas",
    6: "app/repositories",
    7: "app/services",
    8: "app/api",
    9: "app/ai",
    10: "app/rag",
    11: "app/tools",
    12: "app/graph",
    13: "tests",
    14: "eval",
    15: "web",
  };

  const slides = Array.from(document.querySelectorAll(".slide"));
  const rail = document.getElementById("rail");
  const crumbStage = document.getElementById("crumb-stage");
  const crumbTitle = document.getElementById("crumb-title");
  const counter = document.getElementById("counter");
  const bar = document.getElementById("bar");
  const prev = document.getElementById("prev");
  const next = document.getElementById("next");

  let at = 0;

  const firstOf = {};
  slides.forEach(function (slide, index) {
    const stage = slide.dataset.stage;
    if (!(stage in firstOf)) firstOf[stage] = index;
  });

  Object.keys(STAGES).forEach(function (stage) {
    const item = document.createElement("button");
    item.className = "rail-item";
    item.dataset.stage = stage;
    item.innerHTML = '<span class="rail-num">' + (Number(stage) + 1) + "</span><span>" + STAGES[stage] + "</span>";
    item.addEventListener("click", function () {
      if (stage in firstOf) go(firstOf[stage]);
    });
    rail.appendChild(item);
  });

  function go(index) {
    at = Math.max(0, Math.min(slides.length - 1, index));

    slides.forEach(function (slide, i) {
      slide.classList.toggle("on", i === at);
    });

    const slide = slides[at];
    const stage = slide.dataset.stage;

    const inStage = slides.filter(function (s) {
      return s.dataset.stage === stage;
    });
    const place = inStage.indexOf(slide) + 1;

    crumbStage.textContent = STAGES[stage];
    crumbTitle.textContent = slide.dataset.title || "";
    counter.textContent = place + " / " + inStage.length;
    bar.style.width = ((at + 1) / slides.length) * 100 + "%";

    document.querySelectorAll(".rail-item").forEach(function (item) {
      item.setAttribute("aria-current", item.dataset.stage === stage ? "true" : "false");
    });

    prev.disabled = at === 0;
    next.disabled = at === slides.length - 1;
    prev.querySelector(".lbl").textContent = at > 0 ? slides[at - 1].dataset.title : "이전";
    next.querySelector(".lbl").textContent =
      at < slides.length - 1 ? slides[at + 1].dataset.title : "끝";

    window.scrollTo(0, 0);
  }

  prev.addEventListener("click", function () {
    go(at - 1);
  });
  next.addEventListener("click", function () {
    go(at + 1);
  });

  document.addEventListener("keydown", function (event) {
    if (event.target.closest("button, a, input, textarea")) return;
    if (event.key === "ArrowLeft") go(at - 1);
    if (event.key === "ArrowRight") go(at + 1);
  });

  document.querySelectorAll(".copy").forEach(function (button) {
    button.addEventListener("click", async function () {
      const block = button.closest(".file").querySelector("pre");
      try {
        await navigator.clipboard.writeText(block.textContent);
        button.textContent = "복사됨";
        button.classList.add("done");
      } catch (problem) {
        button.textContent = "복사 실패";
      }
      setTimeout(function () {
        button.textContent = "복사";
        button.classList.remove("done");
      }, 1400);
    });
  });

  go(0);
</script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
<script>
  // 코드 블록을 왼쪽에, 그 설명을 오른쪽에 놓습니다.
  //
  // HTML 을 고치지 않고 여기서 묶습니다. 슬라이드의 바로 아래 자식만 봅니다.
  // .file 하나를 찾으면 그 뒤에 붙어있는 설명(.sig / .lines / 그 앞의 h2)을
  // 모아서 오른쪽 칸으로 옮깁니다. 설명이 없으면 그냥 둡니다.
  function splitPairs(slide) {
    var kids = Array.prototype.slice.call(slide.children);

    for (var i = 0; i < kids.length; i++) {
      var code = kids[i];
      if (!code.classList || !code.classList.contains("file")) {
        continue;
      }

      var notes = [];
      var j = i + 1;

      while (j < kids.length) {
        var next = kids[j];
        var cls = next.classList;

        if (cls && (cls.contains("sig") || cls.contains("lines"))) {
          notes.push(next);
          j++;
          continue;
        }

        // "줄별로 보면" 같은 제목은 뒤에 설명이 붙어 있을 때만 데려갑니다
        var after = kids[j + 1];
        if (
          next.tagName === "H2" &&
          after &&
          after.classList &&
          (after.classList.contains("sig") || after.classList.contains("lines"))
        ) {
          notes.push(next);
          j++;
          continue;
        }

        break;
      }

      if (!notes.length) {
        continue;
      }

      var pair = document.createElement("div");
      pair.className = "pair";
      var left = document.createElement("div");
      left.className = "pair-code";
      var right = document.createElement("div");
      right.className = "pair-note";

      slide.insertBefore(pair, code);
      left.appendChild(code);
      notes.forEach(function (note) {
        right.appendChild(note);
      });
      pair.appendChild(left);
      pair.appendChild(right);

      i = j - 1;
    }
  }

  // 흐름을 바꾸는 낱말만 따로 색을 줍니다. VSCode 가 이 둘을 나눠서 칠합니다.
  var CONTROL = [
    "if", "else", "elif", "for", "while", "return", "import", "from", "try",
    "except", "finally", "with", "yield", "break", "continue", "pass", "raise",
    "as", "async", "await", "del", "global", "assert", "throw", "new", "switch",
    "case", "default", "do", "in", "of"
  ];

  // 파일 이름표를 보고 무슨 언어인지 정합니다. 자동 감지는 짧은 조각에서 자주 틀립니다.
  function langFor(name, code) {
    var label = (name || "").toLowerCase();
    var body = (code || "").trim();

    if (label.indexOf(".py") !== -1) return "python";
    if (label.indexOf(".js") !== -1) return "javascript";
    if (label.indexOf(".html") !== -1) return "xml";
    if (label.indexOf(".css") !== -1) return "css";
    if (label.indexOf(".env") !== -1) return "ini";
    if (label.indexOf("터미널") !== -1) return "bash";

    if (body.charAt(0) === "{" || body.charAt(0) === "[") return "json";
    if (/^(python|pytest|uvicorn|pip|git|npm) /.test(body)) return "bash";

    // 코드가 아니라 프롬프트 같은 글이면 색을 입히지 않습니다
    if (!/[=(){}[\]]|def |import |return /.test(body)) return "";

    return "python";
  }

  document.querySelectorAll(".slide").forEach(splitPairs);

  if (typeof hljs !== "undefined") {
    hljs.configure({ ignoreUnescapedHTML: true });

    document.querySelectorAll(".file pre:not(.out)").forEach(function (block) {
      var bar = block.parentElement.querySelector(".file-name");
      var lang = langFor(bar ? bar.textContent : "", block.textContent);
      if (!lang) {
        return;
      }

      block.classList.add("language-" + lang);
      try {
        hljs.highlightElement(block);
      } catch (problem) {
        return;
      }

      block.querySelectorAll(".hljs-keyword").forEach(function (span) {
        if (CONTROL.indexOf(span.textContent.trim()) !== -1) {
          span.classList.add("kw-control");
        }
      });
    });
  }
</script>

<script>
  // 모바일에서 좌우로 밀어 슬라이드를 넘깁니다.
  // 코드 블록 안에서 시작한 손짓은 가로 스크롤이라 건드리지 않습니다.
  (function () {
    var startX = 0;
    var startY = 0;
    var ignore = false;

    document.addEventListener(
      "touchstart",
      function (event) {
        if (event.touches.length !== 1) {
          ignore = true;
          return;
        }
        ignore = !!event.target.closest("pre, .flow, .rail-list, button, a");
        startX = event.touches[0].clientX;
        startY = event.touches[0].clientY;
      },
      { passive: true }
    );

    document.addEventListener(
      "touchend",
      function (event) {
        if (ignore || !event.changedTouches.length) {
          return;
        }
        var moveX = event.changedTouches[0].clientX - startX;
        var moveY = event.changedTouches[0].clientY - startY;

        // 가로로 60px 넘게, 그리고 세로보다 확실히 많이 움직였을 때만
        if (Math.abs(moveX) < 60 || Math.abs(moveX) < Math.abs(moveY) * 1.6) {
          return;
        }
        go(moveX < 0 ? at + 1 : at - 1);
      },
      { passive: true }
    );
  })();
</script>

<script>
  // 모바일에서 슬라이드를 넘길 때 단계 목록 띠를 다시 지나가지 않도록,
  // 문서 맨 위가 아니라 위쪽 바부터 보이게 스크롤합니다.
  (function () {
    var counter = document.getElementById("counter");
    var bar = document.querySelector(".topbar");
    if (!counter || !bar) {
      return;
    }

    function afterChange() {
      if (!window.matchMedia("(max-width: 900px)").matches) {
        return;
      }
      var top = bar.getBoundingClientRect().top + window.scrollY;
      window.scrollTo(0, Math.max(0, top));
    }

    // go() 가 화면을 다시 그릴 때마다 counter 글자가 바뀝니다. 그걸 신호로 씁니다.
    new MutationObserver(function () {
      setTimeout(afterChange, 0);
    }).observe(counter, { childList: true, characterData: true, subtree: true });
  })();
</script>
